<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Realistic Black Hole</title>

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #000;
    }

    body {
        font-family: Arial, Helvetica, sans-serif;
    }

    canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        background: #000;
        cursor: grab;
    }

    canvas:active {
        cursor: grabbing;
    }

    .ui {
        position: fixed;
        left: 28px;
        top: 26px;
        color: rgba(255,255,255,.92);
        pointer-events: none;
        text-shadow:
            0 0 12px rgba(255,160,60,.25),
            0 2px 8px rgba(0,0,0,.9);
        user-select: none;
    }

    .title {
        font-size: clamp(22px, 3vw, 38px);
        letter-spacing: .12em;
        font-weight: 300;
    }

    .subtitle {
        margin-top: 8px;
        font-size: 12px;
        letter-spacing: .16em;
        color: rgba(255,255,255,.46);
    }

    .hint {
        position: fixed;
        bottom: 22px;
        left: 50%;
        transform: translateX(-50%);
        color: rgba(255,255,255,.35);
        font-size: 11px;
        letter-spacing: .14em;
        pointer-events: none;
        user-select: none;
        white-space: nowrap;
    }

    .credit {
        position: fixed;
        right: 20px;
        bottom: 18px;
        font-size: 10px;
        letter-spacing: .12em;
        color: rgba(255,255,255,.18);
        pointer-events: none;
    }
</style>
</head>

<body>

<canvas id="gl"></canvas>

<div class="ui">
    <div class="title">BLACK HOLE</div>
    <div class="subtitle">ACCRETION DISK · GRAVITATIONAL LENSING</div>
</div>

<div class="hint">
    MOVE MOUSE · SCROLL TO ZOOM
</div>

<div class="credit">
    SYSTEM THEORY VISUAL EXPERIMENT
</div>

<script>
const canvas = document.getElementById("gl");
const gl = canvas.getContext("webgl", {
    antialias: false,
    alpha: false,
    preserveDrawingBuffer: false
});

if (!gl) {
    document.body.innerHTML =
        "<div style='color:white;padding:40px;font-family:sans-serif'>" +
        "你的浏览器不支持 WebGL。" +
        "</div>";
    throw new Error("WebGL not supported");
}

/* =========================
   Vertex Shader
========================= */

const vertexShaderSource = `
attribute vec2 a_position;

void main() {
    gl_Position = vec4(a_position, 0.0, 1.0);
}
`;

/* =========================
   Fragment Shader
========================= */

const fragmentShaderSource = `
precision highp float;

uniform vec2 u_resolution;
uniform vec2 u_mouse;
uniform float u_time;
uniform float u_zoom;

#define PI 3.14159265359
#define TAU 6.28318530718


/* =========================
   Utility
========================= */

float hash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);

    f = f * f * (3.0 - 2.0 * f);

    float a = hash21(i);
    float b = hash21(i + vec2(1.0, 0.0));
    float c = hash21(i + vec2(0.0, 1.0));
    float d = hash21(i + vec2(1.0, 1.0));

    return mix(
        mix(a, b, f.x),
        mix(c, d, f.x),
        f.y
    );
}

float fbm(vec2 p) {
    float value = 0.0;
    float amp = 0.5;

    for(int i = 0; i < 5; i++) {
        value += amp * noise(p);
        p = p * 2.03 + vec2(7.1, 3.8);
        amp *= 0.5;
    }

    return value;
}

mat2 rot(float a) {
    float c = cos(a);
    float s = sin(a);

    return mat2(
        c, -s,
        s,  c
    );
}


/* =========================
   Stars
========================= */

vec3 starLayer(vec2 p, float scale, float threshold) {

    p *= scale;

    vec2 cell = floor(p);
    vec2 f = fract(p) - 0.5;

    float h = hash21(cell);

    vec2 starPos = vec2(
        hash21(cell + 15.7),
        hash21(cell + 91.3)
    ) - 0.5;

    float d = length(f - starPos);

    float size = mix(0.025, 0.08, hash21(cell + 31.4));

    float star =
        smoothstep(size, 0.0, d) *
        smoothstep(threshold, 1.0, h);

    star *=
        0.55 +
        1.7 *
        pow(
            max(
                0.0,
                sin(
                    u_time *
                    (0.7 + hash21(cell + 3.1))
                    +
                    h * 30.0
                )
            ),
            6.0
        );

    vec3 colorA = vec3(0.55, 0.68, 1.0);
    vec3 colorB = vec3(1.0, 0.82, 0.62);

    vec3 col = mix(
        colorA,
        colorB,
        hash21(cell + 71.0)
    );

    return col * star;
}


vec3 starField(vec2 p) {

    vec3 col = vec3(0.0);

    col += starLayer(p, 45.0, 0.93);
    col += starLayer(p + 10.0, 85.0, 0.965) * 0.8;
    col += starLayer(p - 17.0, 150.0, 0.984) * 0.6;

    /* Milky Way-like dust */
    vec2 g = rot(-0.24) * p;

    float band =
        exp(
            -abs(
                g.y +
                0.07 * sin(g.x * 2.2)
            ) * 3.5
        );

    float dust =
        fbm(
            g * 3.2 +
            vec2(0.0, 0.08 * u_time)
        );

    col +=
        vec3(0.10, 0.12, 0.18) *
        band *
        dust *
        0.28;

    return col;
}


/* =========================
   Blackbody-style disk color
========================= */

vec3 diskColor(float t) {

    vec3 outer = vec3(
        0.95,
        0.075,
        0.008
    );

    vec3 middle = vec3(
        1.0,
        0.30,
        0.025
    );

    vec3 hot = vec3(
        1.0,
        0.78,
        0.34
    );

    vec3 whiteHot = vec3(
        1.0,
        0.96,
        0.86
    );

    vec3 c =
        mix(
            outer,
            middle,
            smoothstep(0.0, 0.45, t)
        );

    c =
        mix(
            c,
            hot,
            smoothstep(0.35, 0.75, t)
        );

    c =
        mix(
            c,
            whiteHot,
            smoothstep(0.72, 1.0, t)
        );

    return c;
}


/* =========================
   Accretion Disk
========================= */

vec4 accretionDisk(
    vec2 p,
    float time,
    float tilt
) {

    vec2 d = p;

    d = rot(
        0.025 * sin(time * 0.07)
    ) * d;

    d.y /= tilt;

    float r = length(d);

    float angle = atan(d.y, d.x);

    float inner = 0.205;
    float outer = 0.82;

    float ring =
        smoothstep(inner, inner + 0.026, r) *
        (1.0 - smoothstep(outer - 0.08, outer, r));

    float normalized =
        clamp(
            1.0 -
            (r - inner) /
            (outer - inner),
            0.0,
            1.0
        );

    /*
       Differential rotation:
       inner disk rotates faster.
    */
    float speed =
        1.0 /
        pow(
            max(r, 0.15),
            0.74
        );

    float flow =
        angle +
        time *
        0.18 *
        speed;

    float turbulence1 =
        fbm(
            vec2(
                flow * 3.2,
                r * 22.0 - time * 0.55
            )
        );

    float turbulence2 =
        fbm(
            vec2(
                flow * 7.0 + 17.0,
                r * 48.0 + time * 0.19
            )
        );

    float strands =
        sin(
            r * 155.0
            -
            flow * 8.0
            +
            turbulence1 * 8.0
        );

    strands =
        0.52 +
        0.48 *
        smoothstep(
            -0.8,
            0.8,
            strands
        );

    float density =
        mix(
            turbulence1,
            turbulence2,
            0.45
        );

    density =
        pow(
            clamp(density, 0.0, 1.0),
            1.25
        );

    density *= strands;

    /*
      Doppler-like brightness asymmetry.
      One side is brighter than the other.
    */
    float doppler =
        0.62 +
        1.65 *
        pow(
            max(
                0.0,
                0.5 +
                0.5 * cos(angle - 0.25)
            ),
            2.2
        );

    /*
       Extremely hot near inner edge.
    */
    float heat =
        pow(
            normalized,
            1.15
        );

    vec3 color =
        diskColor(heat);

    float brightness =
        ring *
        density *
        doppler;

    brightness *=
        mix(
            0.25,
            3.2,
            heat
        );

    /*
       Thin white-hot inner ring.
    */
    float innerGlow =
        exp(
            -abs(r - inner - 0.018) * 95.0
        );

    color +=
        vec3(
            1.0,
            0.78,
            0.43
        ) *
        innerGlow *
        1.8;

    brightness += innerGlow * 0.85;

    /*
       Break up perfect ellipse.
    */
    brightness *=
        0.68 +
        density * 0.85;

    float alpha =
        clamp(
            brightness,
            0.0,
            1.0
        );

    return vec4(
        color * brightness,
        alpha
    );
}


/* =========================
   Main
========================= */

void main() {

    vec2 frag = gl_FragCoord.xy;

    vec2 uv =
        (frag * 2.0 - u_resolution.xy) /
        u_resolution.y;

    uv /= u_zoom;

    /*
      Mouse movement changes point of view slightly.
    */
    vec2 mouse =
        u_mouse /
        max(
            u_resolution,
            vec2(1.0)
        );

    mouse =
        mouse * 2.0 - 1.0;

    mouse.y *= -1.0;

    uv -= mouse * 0.035;

    float time = u_time;

    float r = length(uv);

    /*
      Event horizon radius
    */
    float horizon = 0.142;

    /*
      Approximate gravitational lensing:
      bend background coordinates near the black hole.
    */
    vec2 lensDir =
        normalize(
            uv +
            vec2(0.000001)
        );

    float bend =
        0.042 /
        (
            r +
            0.055
        );

    bend *=
        smoothstep(
            0.82,
            0.12,
            r
        );

    vec2 lensedUV =
        uv +
        lensDir * bend;

    /*
      Extra angular shear near photon sphere.
    */
    float shear =
        0.09 /
        (
            r * r * 12.0 +
            0.16
        );

    lensedUV =
        rot(
            shear *
            0.10
        ) *
        lensedUV;

    /*
      Background
    */
    vec3 color =
        starField(
            lensedUV * 1.7
        );

    /*
      Dim background near black hole.
    */
    float gravityDarkening =
        smoothstep(
            horizon * 0.95,
            horizon * 3.1,
            r
        );

    color *=
        mix(
            0.04,
            1.0,
            gravityDarkening
        );

    /*
      Accretion disk inclination.
    */
    float tilt =
        0.255 +
        mouse.y * 0.035;

    vec4 disk =
        accretionDisk(
            uv,
            time,
            tilt
        );

    /*
       Rear lensed disk.
       This fake secondary arc gives the characteristic
       black-hole lensing appearance.
    */
    float photonRadius =
        horizon * 1.43;

    vec2 rearP = uv;

    float rearWarp =
        0.034 /
        (
            r +
            0.035
        );

    rearP.y +=
        sign(rearP.y) *
        rearWarp *
        0.33;

    vec4 rearDisk =
        accretionDisk(
            rearP * 0.985,
            time + 1.7,
            tilt * 0.88
        );

    float rearArc =
        exp(
            -abs(
                r -
                photonRadius * 1.42
            ) * 30.0
        );

    rearArc *=
        smoothstep(
            -0.1,
            0.28,
            abs(uv.y)
        );

    color +=
        rearDisk.rgb *
        rearArc *
        0.42;

    /*
      Main disk
    */
    color =
        color * (1.0 - disk.a * 0.75)
        +
        disk.rgb;

    /*
      Photon ring
    */
    float photonRing =
        exp(
            -abs(
                r -
                photonRadius
            ) * 155.0
        );

    float photonHalo =
        exp(
            -abs(
                r -
                photonRadius
            ) * 42.0
        );

    vec3 photonColor =
        vec3(
            1.0,
            0.70,
            0.32
        );

    color +=
        photonColor *
        photonHalo *
        0.26;

    color +=
        vec3(
            1.0,
            0.91,
            0.73
        ) *
        photonRing *
        2.5;

    /*
       Soft gravitational glow.
    */
    float halo =
        exp(
            -r * 7.0
        );

    color +=
        vec3(
            0.13,
            0.035,
            0.012
        ) *
        halo *
        0.36;

    /*
      Event horizon.
    */
    float eventMask =
        1.0 -
        smoothstep(
            horizon - 0.008,
            horizon + 0.006,
            r
        );

    color =
        mix(
            color,
            vec3(0.0),
            eventMask
        );

    /*
      Small rim right outside horizon
    */
    float rim =
        exp(
            -abs(
                r -
                horizon * 1.055
            ) * 100.0
        );

    rim *=
        smoothstep(
            horizon,
            horizon * 1.12,
            r
        );

    color +=
        vec3(
            1.0,
            0.45,
            0.12
        ) *
        rim *
        0.15;

    /*
      Exposure / filmic tone mapping
    */
    color =
        vec3(1.0) -
        exp(
            -color * 1.45
        );

    color =
        pow(
            max(
                color,
                vec3(0.0)
            ),
            vec3(0.82)
        );

    /*
      Vignette
    */
    vec2 screenUV =
        frag /
        u_resolution;

    float vignette =
        screenUV.x *
        screenUV.y *
        (1.0 - screenUV.x) *
        (1.0 - screenUV.y);

    vignette =
        pow(
            vignette * 16.0,
            0.18
        );

    color *=
        0.48 +
        0.52 * vignette;

    /*
      Very subtle cinematic grain
    */
    float grain =
        hash21(
            frag +
            fract(time) * 101.0
        );

    color +=
        (grain - 0.5) *
        0.012;

    gl_FragColor =
        vec4(
            color,
            1.0
        );
}
`;


/* =========================
   Compile shader
========================= */

function createShader(type, source) {

    const shader = gl.createShader(type);

    gl.shaderSource(shader, source);
    gl.compileShader(shader);

    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        console.error(
            gl.getShaderInfoLog(shader)
        );

        throw new Error(
            "Shader compile error"
        );
    }

    return shader;
}


const vertexShader =
    createShader(
        gl.VERTEX_SHADER,
        vertexShaderSource
    );

const fragmentShader =
    createShader(
        gl.FRAGMENT_SHADER,
        fragmentShaderSource
    );


const program =
    gl.createProgram();

gl.attachShader(
    program,
    vertexShader
);

gl.attachShader(
    program,
    fragmentShader
);

gl.linkProgram(program);

if (
    !gl.getProgramParameter(
        program,
        gl.LINK_STATUS
    )
) {
    console.error(
        gl.getProgramInfoLog(program)
    );

    throw new Error(
        "Program link error"
    );
}

gl.useProgram(program);


/* =========================
   Full screen triangle
========================= */

const buffer =
    gl.createBuffer();

gl.bindBuffer(
    gl.ARRAY_BUFFER,
    buffer
);

gl.bufferData(
    gl.ARRAY_BUFFER,
    new Float32Array([
        -1, -1,
         3, -1,
        -1,  3
    ]),
    gl.STATIC_DRAW
);

const positionLocation =
    gl.getAttribLocation(
        program,
        "a_position"
    );

gl.enableVertexAttribArray(
    positionLocation
);

gl.vertexAttribPointer(
    positionLocation,
    2,
    gl.FLOAT,
    false,
    0,
    0
);


/* =========================
   Uniforms
========================= */

const resolutionLocation =
    gl.getUniformLocation(
        program,
        "u_resolution"
    );

const mouseLocation =
    gl.getUniformLocation(
        program,
        "u_mouse"
    );

const timeLocation =
    gl.getUniformLocation(
        program,
        "u_time"
    );

const zoomLocation =
    gl.getUniformLocation(
        program,
        "u_zoom"
    );


/* =========================
   Interaction
========================= */

let mouseX = window.innerWidth / 2;
let mouseY = window.innerHeight / 2;

let smoothMouseX = mouseX;
let smoothMouseY = mouseY;

let zoom = 1.0;
let targetZoom = 1.0;

window.addEventListener(
    "mousemove",
    e => {
        mouseX = e.clientX;
        mouseY = e.clientY;
    }
);

window.addEventListener(
    "touchmove",
    e => {
        if (!e.touches.length) return;

        mouseX =
            e.touches[0].clientX;

        mouseY =
            e.touches[0].clientY;
    },
    {
        passive: true
    }
);

window.addEventListener(
    "wheel",
    e => {

        targetZoom +=
            e.deltaY * -0.0007;

        targetZoom =
            Math.min(
                Math.max(
                    targetZoom,
                    0.65
                ),
                2.25
            );
    },
    {
        passive: true
    }
);


/* =========================
   Resize
========================= */

function resize() {

    const dpr =
        Math.min(
            window.devicePixelRatio || 1,
            1.7
        );

    const width =
        Math.floor(
            window.innerWidth * dpr
        );

    const height =
        Math.floor(
            window.innerHeight * dpr
        );

    if (
        canvas.width !== width ||
        canvas.height !== height
    ) {
        canvas.width = width;
        canvas.height = height;

        gl.viewport(
            0,
            0,
            width,
            height
        );
    }
}


/* =========================
   Render
========================= */

const startTime =
    performance.now();

function render(now) {

    resize();

    const time =
        (now - startTime) /
        1000;

    smoothMouseX +=
        (mouseX - smoothMouseX) *
        0.04;

    smoothMouseY +=
        (mouseY - smoothMouseY) *
        0.04;

    zoom +=
        (targetZoom - zoom) *
        0.06;

    const dpr =
        canvas.width /
        window.innerWidth;

    gl.uniform2f(
        resolutionLocation,
        canvas.width,
        canvas.height
    );

    gl.uniform2f(
        mouseLocation,
        smoothMouseX * dpr,
        (
            window.innerHeight -
            smoothMouseY
        ) * dpr
    );

    gl.uniform1f(
        timeLocation,
        time
    );

    gl.uniform1f(
        zoomLocation,
        zoom
    );

    gl.drawArrays(
        gl.TRIANGLES,
        0,
        3
    );

    requestAnimationFrame(
        render
    );
}

requestAnimationFrame(
    render
);
</script>

</body>
</html>
